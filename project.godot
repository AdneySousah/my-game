; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Herdeiro dos Céus"
config/version="0.3.3"
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/app/icon_512.png"

[autoload]

Game="*res://scripts/autoload/game.gd"
Data="*res://scripts/autoload/data.gd"
Session="*res://scripts/autoload/session.gd"
SaveGame="*res://scripts/autoload/save_game.gd"
Audio="*res://scripts/autoload/audio.gd"
Store="*res://scripts/autoload/store.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGooglePlayBilling/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/fallback="pt_BR"
locale/translations=PackedStringArray("res://data/i18n/strings.pt_BR.translation", "res://data/i18n/strings.en.translation")

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true

[shader_globals]

wind_dir={
"type": "vec2",
"value": Vector2(1, 0.35)
}
wind_strength={
"type": "float",
"value": 1.0
}
biome_dry={
"type": "float",
"value": 0.0
}
biome_snow={
"type": "float",
"value": 0.0
}
biome_moss={
"type": "float",
"value": 0.0
}
